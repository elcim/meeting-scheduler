# Copy to `.env` (read automatically by docker-compose) to change the defaults. All values are optional.

# Port of the API: the application listens on it and it is published under the same number on the host.
# `mvn spring-boot:run` honours APP_PORT too, but defaults to 8080 when it is not set.
APP_PORT=8088

# Host port of PostgreSQL (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# Password of the database user. Change it outside local development.
POSTGRES_PASSWORD=scheduler
